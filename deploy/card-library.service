[Unit]
Description=MapleStory card library bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=card-library
Group=card-library
WorkingDirectory=/opt/card-library/bridge
EnvironmentFile=/etc/card-library.env
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/card-library
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
